<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- CalVer: <Jahr>.<Monat>.<Release-Zähler im Monat>. Die dritte Stelle ist kein
         SemVer-Patch, sondern zählt die Releases des Monats (2026.7.0, 2026.7.1, …).
         Bewusst nur hier gesetzt, nicht in einer Directory.Build.props: Contracts/Plugin
         und die Plugins folgen SemVer und dürfen diese Version nicht erben. -->
    <Version>2026.10.0</Version>
    <Product>ClubGear</Product>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="Contracts/Plugin/**/*.cs" />
    <Compile Remove="plugins/**/*.cs" />
    <Content Remove="tests/**;**/bin/**;**/obj/**" />
    <Content Remove="plugins/**" />
    <None Remove="tests/**;**/bin/**;**/obj/**" />
    <None Remove="plugins/**" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>ClubGear.ArchitectureTests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MailKit" Version="4.17.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="8.0.30" />
    <PackageReference Include="MimeKit" Version="4.17.0" />
    <ProjectReference Include="Contracts/Plugin/ClubGear.Plugin.Contracts.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.30" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.30">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
