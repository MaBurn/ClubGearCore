{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "onboarding": false,
  "requireConfig": "optional",
  "dependencyDashboard": true,
  "pinDigests": true,
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "docker-compose",
    "dockerfile",
    "gitlabci",
    "nuget"
  ],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Group Microsoft .NET dependencies",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "/^Microsoft\\./"
      ],
      "groupName": "Microsoft .NET dependencies"
    },
    {
      "description": "Do not automerge major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ]
}
