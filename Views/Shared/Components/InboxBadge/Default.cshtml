@model int

<a class="nav-link position-relative" asp-controller="Messages" asp-action="Index">
    <i class="bi bi-envelope"></i> Nachrichten
    @if (Model > 0)
    {
        <span class="badge rounded-pill text-bg-danger ms-1">@Model</span>
        <span class="visually-hidden">@Model ungelesene Nachrichten</span>
    }
</a>
