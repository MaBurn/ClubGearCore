@using ClubGear.Controllers
@using ClubGear.Models
@model MessagesIndexViewModel
@{
    ViewData["Title"] = "Nachrichten";
    var unread = Model.Threads.Sum(t => t.UnreadCount);
}

<div class="cg-page">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="cg-page-title mb-1">Nachrichten</h1>
            <p class="text-muted mb-0">
                @if (unread > 0)
                {
                    <span>@unread ungelesen</span>
                }
                else
                {
                    <span>Alles gelesen</span>
                }
            </p>
        </div>

        @if (Model.MemberLinked)
        {
            <a class="btn btn-outline-secondary btn-sm"
               asp-action="Index" asp-route-includeClosed="@(!Model.IncludeClosed)">
                @(Model.IncludeClosed ? "Geschlossene ausblenden" : "Geschlossene anzeigen")
            </a>
        }
    </div>

    @if (!Model.MemberLinked)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-1"></i>
            Dieses Konto ist keinem Mitglied zugeordnet, deshalb gibt es hier keinen Posteingang.
        </div>
    }
    else if (Model.Threads.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted d-block mb-2"></i>
                <p class="mb-0 text-muted">Keine Nachrichten.</p>
            </div>
        </div>
    }
    else
    {
        <div class="list-group shadow-sm">
            @foreach (var summary in Model.Threads)
            {
                var isUnread = summary.UnreadCount > 0;
                <a class="list-group-item list-group-item-action d-flex gap-3 align-items-start"
                   asp-action="Detail" asp-route-threadId="@summary.Thread.Id">
                    <span class="pt-1">
                        @if (summary.Thread.Kind == MessageThreadKinds.Notification)
                        {
                            <i class="bi bi-bell text-secondary" title="Benachrichtigung" aria-label="Benachrichtigung"></i>
                        }
                        else
                        {
                            <i class="bi bi-chat-dots text-secondary" title="Unterhaltung" aria-label="Unterhaltung"></i>
                        }
                    </span>

                    <span class="flex-grow-1 min-w-0">
                        <span class="d-flex align-items-center gap-2">
                            <span class="@(isUnread ? "fw-semibold" : "")">@summary.Thread.Subject</span>
                            @if (summary.Thread.IsClosed)
                            {
                                <span class="badge text-bg-light border">geschlossen</span>
                            }
                        </span>
                        @if (summary.LastMessagePreview is not null)
                        {
                            <span class="d-block text-muted small text-truncate">@summary.LastMessagePreview</span>
                        }
                    </span>

                    <span class="text-end flex-shrink-0">
                        @if (summary.LastMessageAtUtc is DateTime at)
                        {
                            <span class="d-block text-muted small">@at.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        }
                        @if (isUnread)
                        {
                            <span class="badge rounded-pill text-bg-primary">@summary.UnreadCount</span>
                        }
                    </span>
                </a>
            }
        </div>
    }
</div>
