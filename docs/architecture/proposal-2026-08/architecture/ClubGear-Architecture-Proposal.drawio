ontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="646" width="350" height="20" as="geometry"/></mxCell><mxCell id="t33" value="identity, permissions, members, organisation, files, templates,&#10;notifications, workflow, calendar, audit." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="670" width="350" height="90" as="geometry"/></mxCell><mxCell id="t34" value="Plugins own the domain" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435" y="646" width="350" height="20" as="geometry"/></mxCell><mxCell id="t35" value="inventory, finance, newsletter, rental, documents, connectors —&#10;each with its own schema, permissions and release cycle." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="435" y="670" width="350" height="90" as="geometry"/></mxCell><mxCell id="t36" value="No vendor in core" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810" y="646" width="350" height="20" as="geometry"/></mxCell><mxCell id="t37" value="Matrix, Nextcloud, Listmonk, Traccar and postal services are&#10;provider plugins behind generic contracts." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="810" y="670" width="350" height="90" as="geometry"/></mxCell><mxCell id="t38" value="One of everything" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1185" y="646" width="350" height="20" as="geometry"/></mxCell><mxCell id="t39" value="one template system, one file service, one audit trail,&#10;one inbox — no parallel legacy paths." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1185" y="670" width="350" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg2" name="2 · Target architecture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Target architecture — layers and ownership" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1000" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Blue = ClubGear core.  Orange = the versioned plugin contract.  Purple = plugins (own repository, own SemVer, own schema).  Dashed = new or substantially extended by this proposal." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell><mxCell id="b3" value="Presentation — one rendering pipeline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1620" height="120" as="geometry"/></mxCell><mxCell id="n4" value="Razor views&#10;members, organisation, admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="146" width="380" height="66" as="geometry"/></mxCell