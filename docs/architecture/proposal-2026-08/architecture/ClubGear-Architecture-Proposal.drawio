ll><mxCell id="t41" value="Everything else — Matrix, Telegram, SMS, E-Post — is an installable&#10;provider plugin. Core has no provider branch, key, icon or DTO." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="812" width="340" height="90" as="geometry"/></mxCell><mxCell id="t42" value="Fallback is explicit per event" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="786" width="340" height="20" as="geometry"/></mxCell><mxCell id="t43" value="queue and retry · fall back to e-mail · inbox only · fail and report.&#10;Core must never silently pick another medium." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="440" y="812" width="340" height="90" as="geometry"/></mxCell><mxCell id="t44" value="Capability negotiation, not assumption" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800" y="786" width="340" height="20" as="geometry"/></mxCell><mxCell id="t45" value="An event declares what it needs; a provider advertises what it supports.&#10;A provider that cannot carry an attachment is not selected." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="800" y="812" width="340" height="90" as="geometry"/></mxCell><mxCell id="t46" value="Provider lifecycle never destroys history" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1160" y="786" width="340" height="20" as="geometry"/></mxCell><mxCell id="t47" value="Deactivating or removing a provider hides the channel and keeps&#10;notifications, delivery records and user preferences intact." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1160" y="812" width="340" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg5" name="5 · Plugin surface request lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="CORE-03 — what happens when a plugin page is opened" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t2" value="The host performs every security-relevant step. The plugin contributes data and executes commands. The same definition serves the HTML page and its JSON twin." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Browser&#10;or mobile client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#8a949c;fontColor=#3f474d;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="200" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Host controller&#10;PluginPage / API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="240" height="70" as="geometry"/></mxCell><mxCell id="b5" value="Host pipeline — always, for every plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="620" y="120" width="420" height="400" as="geometry"/></mxCell><mxCell id="n6" value="Authentication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="380" height="48" as="geometry"/></mxCell><mxCell id="n7" value="Anti-CSRF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="218" width="380" height="48" as="geometry"/></mxCell><mxCell id="n8" value="Permission check&#10;(declared key, unit-scoped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="276" width="380" height="48" as="geometry"/></mxCell><mxCell id="n9" value="Contract version gate" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="334" width="380" height="48" as="geometry"/></mxCell><mxCell id="n10" value="Model validation&#10;against the declared schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="392" width="380" height="48" as="geometry"/></mxCell><mxCell id="n11" value="Output encoding + messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="380" height="48" as="geometry"/></mxCell><mxCell id="n12" value="Plugin contract call&#10;GetPageDefinition&#10;GetRows&#10;ExecuteCommand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1100" y="200" width="260" height="110" as="geometry"/></mxCell><mxCell id="n13" value="Plugin module&#10;business logic only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1420" y="200" width="220" height="110" as="geometry"/></mxCell><mxCell id="n14" value="IPluginHostContext&#10;member read model&#10;permission facade&#10;notification facade&#10;audit facade&#10;file storage (CORE-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1100" y="380" width="260" height="130" as="geometry"/></mxCell><mxCell id="n15" value="IPluginDataStore&#10;prefixed tables,&#10;own migrations,&#10;no core table access" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f4ec;strokeColor=#187344;fontColor=#0f4d2d;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1420" y="380" width="220" height="130" as="geometry"/></mxCell><mxCell id="e16" value="GET / POST" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="definition + rows + result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#EF7D00;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.25;entryX=1;entryY=0.25;" edge="1" parent="1" source="n12" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b28" value="What the contract must gain — and what it must never gain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1580" height="190" as="geometry"/></mxCell><mxCell id="t29" value="Add (generic UI and transport concepts)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#187344;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="596" width="740" height="20" as="geometry"/></mxCell><mxCell id="t30" value="· typed action arguments instead of string dictionaries&#10;· filters, sorting, pagination, detail views, confirmation actions&#10;· validated upload and streamed download actions&#10;· namespaced JSON endpoints with a documented error envelope&#10;· activation-time validation of keys, routes, permissions and schemas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="620" width="740" height="120" as="geometry"/></mxCell><mxCell id="t31" value="Never add" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#b05252;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="596" width="760" height="20" as="geometry"/></mxCell><mxCell id="t32" value="· Inventory-, Finance- or any product-specific DTO in the contract&#10;· a core branch that compares a module id to choose behaviour&#10;· plugin access to core tables or a core reference from a plugin&#10;· raw HTML from a plugin rendered without escaping&#10;· a second out-of-process / gRPC plugin mechanism" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="860" y="620" width="760" height="120" as="geometry"/></mxCell><mxCell id="b33" value="Migration of the existing plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1580" height="170" as="geometry"/></mxCell><mxCell id="t34" value="CarInfo, ServiceBook, Inventar, Finance and IamOidc already run on contract 1.10.0. The extension is additive: new optional interfaces and new contribution kinds, with the minimum-supported version raised only when an old shape is actually removed.&#10;&#10;Practical rule from the existing guardrails: before each domain plugin is built, decide the smallest contract increment it needs, ship that increment with compatibility tests, and only then build the plugin. Never widen the contract speculatively." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="816" width="1540" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg6" name="6 · Secure file storage"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1020" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="CORE-02 — one storage service, opaque references" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Business modules store a file id and metadata. Nobody writes into wwwroot, nobody trusts a client path, and no plugin can reach another plugin&#x27;s files." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Profile image (core)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="56" as="geometry"/></mxCell><mxCell id="n4" value="Template assets (core)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="220" width="260" height="56" as="geometry"/></mxCell><mxCell id="n5" value="Inventory images (plugin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="290" width="260" height="56" as="geometry"/></mxCell><mxCell id="n6" value="Finance imports (plugin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="260" height="56" as="geometry"/></mxCell><mxCell id="n7" value="Newsletter attachments (plugin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="260" height="56" as="geometry"/></mxCell><mxCell id="n8" value="Documents (plugin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="260" height="56" as="geometry"/></mxCell><mxCell id="n9" value="IFileStorage&#10;upload · read · stream&#10;replace · delete&#10;namespaced per scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="220" height="180" as="geometry"/></mxCell><mxCell id="b10" value="Upload pipeline — same gates for core and plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="400" height="470" as="geometry"/></mxCell><mxCell id="n11" value="Policy lookup for the owner scope" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="168" width="360" height="42" as="geometry"/></mxCell><mxCell id="n12" value="Size and quota limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="220" width="360" height="42" as="geometry"/></mxCell><mxCell id="n13" value="Extension and declared MIME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="272" width="360" height="42" as="geometry"/></mxCell><mxCell id="n14" value="Content signature check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="324" width="360" height="42" as="geometry"/></mxCell><mxCell id="n15" value="Malware hook → quarantine state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="680" y="376" width="360" height="42" as="geometry"/></mxCell><mxCell id="n16" value="Generated storage name (no traversal)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="68