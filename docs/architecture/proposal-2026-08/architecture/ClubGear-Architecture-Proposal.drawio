tyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n16" target="n17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n17" target="n18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n18" target="n19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e39" value="bytes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n19" target="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n20" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n20" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n9" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b43" value="Rules that make this worth building once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="980" height="340" as="geometry"/></mxCell><mxCell id="t44" value="·  Two files with the same original name never overwrite each other — the storage name is generated." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="682" width="940" height="30" as="geometry"/></mxCell><mxCell id="t45" value="·  A plugin can store and read its own file and cannot resolve or enumerate another plugin&#x27;s file." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="716" width="940" height="30" as="geometry"/></mxCell><mxCell id="t46" value="·  Client-supplied MIME type and extension are never trusted on their own." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="750" width="940" height="30" as="geometry"/></mxCell><mxCell id="t47" value="·  Large files are streamed; partial uploads are cleaned up; cancellation is honoured." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="784" width="940" height="30" as="geometry"/></mxCell><mxCell id="t48" value="·  Deleting a business object marks its files for deletion; cleanup is retryable and reports orphans." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="818" width="940" height="30" as="geometry"/></mxCell><mxCell id="t49" value="·  Upload, replacement, deletion and downloads of sensitive files are auditable." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="852" width="940" height="30" as="geometry"/></mxCell><mxCell id="t50" value="·  The backend is selectable per installation and optionally per scope — local or Nextcloud (page 9)." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="886" width="940" height="30" as="geometry"/></mxCell><mxCell id="t51" value="·  Business code, plugins and the metadata model are identical whichever backend is active." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#3f474d;" vertex="1" parent="1"><mxGeometry x="80" y="920" width="940" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg7" name="7 · Data ownership and isolation"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Who may read what" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t2" value="The boundary that keeps plugins releasable on their own. Green arrows are allowed; red dashed arrows are the shortcuts that must stay impossible." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell><mxCell id="b3" value="Core schema — ApplicationDbContext, EF migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="640" height="520" as="geometry"/></mxCell><mxCell id="n4" value="Members, addresses, membership types" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="160" width="600" height="36" as="geometry"/></mxCell><mxCell id="n5" value="Organisation units + memberships (CORE-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="206" width="600" height="36" as="geometry"/></mxCell><mxCell id="n6" value="Household relationships (CORE-08)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="252" width="600" height="36" as="geometry"/></mxCell><mxCell id="n7" value="Users, roles, permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="298" width="600" height="36" as="geometry"/></mxCell><mxCell id="n8" value="Events, registrations (CORE-07)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="344" width="600" height="36" as="geometry"/></mxCell><mxCell id="n9" value="Templates + versions (CORE-05)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="390" width="600" height="36" as="geometry"/></mxCell><mxCell id="n10" value="Notifications + preferences (CORE-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="436" width="600" height="36" as="geometry"/></mxCell><mxCell id="n11" value="Workflow definitions + instances (CORE-06)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="482" width="600" height="36" as="geometry"/></mxCell><mxCell id="n12" value="File metadata (CORE-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="528" width="600" height="36" as="geometry"/></mxCell><mxCell id="n13" value="Audit log, event log, system config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="80" y="574" width="600" height="36" as="geometry"/></mxCell><mxCell id="b14" value="Plugin schemas — one prefix per plugin, own migrations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="600" height="520" as="geometry"/></mxCell><mxCell id="n15" value="inv_*  items, warehouses, stock, history, images" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="160" width="560" height="52" as="geometry"/></mxCell><mxCell id="n16" value="fin_*  accounts, mandates, demands, payments, batches" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="226" width="560" height="52" as="geometry"/></mxCell><mxCell id="n17" value="news_* campaigns, recipient snapshots, consent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="292" width="560" height="52" as="geometry"/></mxCell><mxCell id="n18" value="rent_* listings, orders, deposits, damages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="358" width="560" height="52" as="geometry"/></mxCell><mxCell id="n19" value="car_*  vehicles     ·     sb_*  service records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="424" width="560" height="52" as="geometry"/></mxCell><mxCell id="n20" value="cal_*  external calendar mappings and sync state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="490" width="560" height="52" as="geometry"/></mxCell><mxCell id="n21" value="chan_* provider config (encrypted) + destinations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="556" width="560" height="52" as="geometry"/></mxCell><mxCell id="n22" value="Read models&#10;and facades&#10;&#10;member summary&#10;unit reference&#10;household snapshot&#10;permission check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="730" y="250" width="180" height="150" as="geometry"/></mxCell><mxCell id="n23" value="Plugin code (in-process, contract only)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1180" y="660" width="340" height="60" as="geometry"/></mxCell><mxCell id="e24" value="allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#187344;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e25" value="authorised read model" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#187344;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.35;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#187344;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.55;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#187344;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n22" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e28" value="own tables" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e29" value="never — no direct table access" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#b05252;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="n23" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="Allowed:  plugin  →  contract facade  →  core read model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e4f2ea;strokeColor=#187344;fontColor=#0f4d2d;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="160" y="700" width="460" height="56" as="geometry"/></mxCell><mxCell id="n31" value="Forbidden:  plugin  →  core table  ·  core  →  plugin table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="700" width="460" height="56" as="geometry"/></mxCell><mxCell id="b32" value="Consequences" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1480" height="160" as="geometry"/></mxCell><mxCell id="t33" value="· A plugin can be uninstalled without leaving foreign keys behind in the core schema.&#10;· Core migrations never have to know a plugin exists.&#10;· Finance keeps bank data; it is never merged back into member tables.&#10;· A read model is a contract: widening it is a SemVer decision, not a refactor." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="826" width="700" height="120" as="geometry"/></mxCell><mxCell id="t34" value="· Rental pays through a Finance contract or event, never through fin_* tables.&#10;· Newsletter reads an approved recipient projection, not the member entity.&#10;· Plugin removal keeps notification history and template versions intact.&#10;· Files belong to a scope, so uninstall policy can decide what to purge." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="820" y="826" width="700" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg8" name="8 · Delivery sequence"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="A sequence that keeps the product usable at every step" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1100" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Each block ends with something a member or administrator can actually use. Estimates are implementation plus tests, excluding historical data migration." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1300" height="40" as="geometry"/></mxCell><mxCell id="n3" value="Block A — platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="380" height="50" as="geometry"/></mxCell><mxCell id="n4" value="CORE-03 contract spike, driven by the real needs of&#10;Inventory, Finance and one upload-heavy plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="190" width="380" height="90" as="geometry"/></mxCell><mxCell id="n5" value="CORE-02 file storage incl. the backend port,&#10;first used by profile images and one plugin slot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="295" width="380" height="90" as="geometry"/></mxCell><mxCell id="n6" value="CORE-01 organisation units, memberships,&#10;delegated administration — no calendar yet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="380" height="90" as="geometry"/></mxCell><mxCell id="n7" value="≈ 33–50 PT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c98a1e;fontColor=#7a5310;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="515" width="380" height="44" as="geometry"/></mxCell><mxCell id="n8" value="Block B — communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="120" width="380" height="50" as="geometry"/></mxCell><mxCell id="n9" value="CORE-05 versioned templates + semantic event keys,&#10;replacing the ad-hoc renderer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="190" width="380" height="90" as="geometry"/></mxCell><mxCell id="n10" value="CORE-04 inbox, preferences, provider contract,&#10;plus one reference channel plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="295" width="380" height="90" as="geometry"/></mxCell><mxCell id="n11" value="CORE-08 household relationships incl. the read model&#10;Finance will consume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="460" y="400" width="380" height="90" as="geometry"/></mxCell><mxCell id="n12" value="≈ 32–50 PT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c98a1e;fontColor=#7a5310;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="515" width="380" height="44" as="geometry"/></mxCell><mxCell id="n13" value="Block C — existing plugins" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=13;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="120" width="380" height="50" as="geometry"/></mxCell><mxCell id="n14" value="Capability matrix of Inventar and Finance against the&#10;Clubmanager actions they replace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="190" width="380" height="90" as="geometry"/></mxCell><mxCell id="n15" value="INV-01 in slices: warehouses+stock → images+codes →&#10;loans → mobile API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="295" width="380" height="90" as="geometry"/></mxCell><mxCell id="n16" value="FIN-01 in slices: fee runs → payment import/matching →&#10;SEPA export → treasurer dashboards" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="400" width="380" height="90" as="geometry"/></mxCell><mxCell id="n17" value="≈ 55–90 PT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c98a1e;fontColor=#7a5310;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="860" y="515" width="380" height="44" as="geometry"/></mxCell><mxCell id="n18" value="Block D — new modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=13;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="120" width="380" height="50" as="geometry"/></mxCell><mxCell id="n19" value="CORE-06 workflow, then CORE-07 calendar with the&#10;store port, then the Nextcloud plugin (NC-01)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="190" width="380" height="90" as="geometry"/></mxCell><mxCell id="n20" value="NEWS-01 newsletter, POST-01 letters,&#10;further channel providers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="295" width="380" height="90" as="geometry"/></mxCell><mxCell id="n21" value="RENT-01, EDIT-01, DOC-01 and the P3 optional set" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1260" y="400" width="380" height="90" as="geometry"/></mxCell><mxCell id="n22" value="≈ 100+ PT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c98a1e;fontColor=#7a5310;fontSize=12;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1260" y="515" width="380" height="44" as="geometry"/></mxCell><mxCell id="b23" value="Two decisions worth taking before Block A starts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="1580" height="210" as="geometry"/></mxCell><mxCell id="t24" value="1.  How much Clubmanager parity is actually required?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="760" height="20" as="geometry"/></mxCell><mxCell id="t25" value="The backlog contains 26 features and roughly 400+ person-days. Clubmanager itself has 115 tables and 58 controllers, several of them 50–280 KB in size. A full port is a multi-year effort for one person. The realistic question is which three or four domains must exist before the old system can be switched off — the rest can stay in Clubmanager or be dropped entirely." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="706" width="760" height="130" as="geometry"/></mxCell><mxCell id="t26" value="2.  Where does the contract stop?" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="680" width="760" height="20" as="geometry"/></mxCell><mxCell id="t27" value="CORE-03 is the single highest-leverage item and also the easiest to over-build. The proposal deliberately keeps it demand-driven: extend the contract only for a capability a concrete plugin needs now, with a compatibility test per increment. If the contract is designed speculatively, every later plugin pays for the wrong abstraction." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="880" y="706" width="760" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg9" name="9 · Pluggable storage — local or Nextcloud"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1170" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Local or Nextcloud — one port, two adapters, per-instance choice" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1200" height="30" as="geometry"/></mxCell><mxCell id="t2" value="The core defines where bytes and appointments are read and written. The Nextcloud implementation is a plugin, so the »no vendor in core« rule still holds. The administrator picks the adapter." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="40" as="geometry"/></mxCell><mxCell id="b3" value="Core services that need a store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="360" height="400" as="geometry"/></mxCell><mxCell id="n4" value="CORE-02  File storage&#10;owns metadata, policy,&#10;authorisation, audit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="156" width="320" height="84" as="geometry"/></mxCell><mxCell id="n5" value="CORE-07  Calendar&#10;owns events, registrations,&#10;capacity, permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="260" width="320" height="84" as="geometry"/></mxCell><mxCell id="t6" value="Neither service knows what Nextcloud is.&#10;They depend only on the two ports on the right." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="320" height="120" as="geometry"/></mxCell><mxCell id="b7" value="Ports — defined in the core / contract" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="440" y="110" width="420" height="400" as="geometry"/></mxCell><mxCell id="n8" value="IFileStorageBackend&#10;&#10;put(key, stream, ct)&#10;open(key) → stream&#10;delete(key) · exists(key)&#10;health() · capabilities()&#10;&#10;the key is generated by the core" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="150" width="380" height="150" as="geometry"/></mxCell><mxCell id="n9" value="ICalendarStore&#10;&#10;readRange(from, to, syncToken)&#10;upsert(item, ifMatch) · delete(uid)&#10;syncToken() · reportConflicts()&#10;&#10;carries the complete VEVENT:&#10;fields, attendees, extensions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="320" width="380" height="170" as="geometry"/></mxCell><mxCell id="b10" value="Adapters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="900" y="110" width="380" height="400" as="geometry"/></mxCell><mxCell id="n11" value="Local filesystem backend&#10;ships with the core · default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="150" width="340" height="66" as="geometry"/></mxCell><mxCell id="n12" value="Nextcloud WebDAV backend&#10;clubgear.plugin.nextcloud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="226" width="340" height="74" as="geometry"/></mxCell><mxCell id="n13" value="Local calendar store&#10;ClubGear database · default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="320" width="340" height="66" as="geometry"/></mxCell><mxCell id="n14" value="Nextcloud CalDAV store&#10;clubgear.plugin.nextcloud&#10;credentials, discovery, chunking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="920" y="396" width="340" height="94" as="geometry"/></mxCell><mxCell id="n15" value="Your Nextcloud&#10;&#10;WebDAV  /ClubGear/storage&#10;CalDAV  calendar collections&#10;dedicated service account" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#8a949c;fontColor=#3f474d;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1340" y="260" width="320" height="110" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n12" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#5b3d86;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b24" value="Stays in ClubGear whichever adapter is active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="800" height="300" as="geometry"/></mxCell><mxCell id="t25" value="Files" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="578" width="380" height="20" as="geometry"/></mxCell><mxCell id="t26" value="· File metadata: id, scope, display name, media type, size, checksum, state" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="602" width="380" height="40" as="geometry"/></mxCell><mxCell id="t27" value="· Which backend currently holds each object — so a migration can run online" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="644" width="380" height="40" as="geometry"/></mxCell><mxCell id="t28" value="· Every authorisation decision; a Nextcloud share link is never the access path" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="686" width="380" height="40" as="geometry"/></mxCell><mxCell id="t29" value="· Audit entries for upload, replacement, deletion and sensitive downloads" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="728" width="380" height="40" as="geometry"/></mxCell><mxCell id="t30" value="Calendar  (Nextcloud mode — see page 10)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="578" width="360" height="20" as="geometry"/></mxCell><mxCell id="t31" value="· A discardable read cache — no events or registrations table of its own" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="460" y="602" width="360" height="40" as="geometry"/></mxCell><mxCell id="t32" value="· The member ↔ ATTENDEE link, so a deletion request can be honoured" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="460" y="644" width="360" height="40" as="geometry"/></mxCell><mxCell id="t33" value="· Audit entries for what was changed through ClubGear" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="460" y="686" width="360" height="40" as="geometry"/></mxCell><mxCell id="t34" value="· Notification records for invitations and change notices" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="460" y="728" width="360" height="40" as="geometry"/></mxCell><mxCell id="b35" value="Rules that make the choice safe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="540" width="780" height="300" as="geometry"/></mxCell><mxCell id="t36" value="No silent fallback" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="578" width="740" height="18" as="geometry"/></mxCell><mxCell id="t37" value="If the selected backend is unreachable, the operation fails with a clear error.&#10;ClubGear never quietly writes to the other store — same rule as the channels." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="900" y="598" width="740" height="40" as="geometry"/></mxCell><mxCell id="t38" value="Switching is a verified copy, not a toggle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="630" width="740" height="18" as="geometry"/></mxCell><mxCell id="t39" value="Changing the backend starts a resumable job. Source objects are deleted only after&#10;the checksum is verified at the destination; both stores stay readable meanwhile." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="900" y="650" width="740" height="40" as="geometry"/></mxCell><mxCell id="t40" value="Uninstall is guarded" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="682" width="740" height="18" as="geometry"/></mxCell><mxCell id="t41" value="The Nextcloud plugin cannot be removed while objects or calendars still live there.&#10;The host requires a migration back to local first." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="900" y="702" width="740" height="40" as="geometry"/></mxCell><mxCell id="t42" value="Files and calendar differ deliberately" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="734" width="740" height="18" as="geometry"/></mxCell><mxCell id="t43" value="Files: metadata stays in ClubGear, only the bytes move. Calendar: the whole entry&#10;lives in Nextcloud and ClubGear keeps only a cache. That is the explicit instruction." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="900" y="754" width="740" height="40" as="geometry"/></mxCell><mxCell id="t44" value="Credentials are secrets" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#16354f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="786" width="740" height="18" as="geometry"/></mxCell><mxCell id="t45" value="App password encrypted at rest, redacted in UI and logs, never returned by the&#10;ordinary configuration API." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="900" y="806" width="740" height="40" as="geometry"/></mxCell><mxCell id="b46" value="Why this shape, and what it costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1620" height="260" as="geometry"/></mxCell><mxCell id="t47" value="Why a port rather than »Nextcloud support«" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#187344;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="908" width="500" height="20" as="geometry"/></mxCell><mxCell id="t48" value="Clubmanager wired Nextcloud directly into the calendar and the document features:&#10;NextcloudCalendarService is 42 KB, NextcloudDocumentService 26 KB, WebDavService 19 KB,&#10;and both config tables store the app password in plain text with a »TODO: encrypt«.&#10;&#10;A port keeps that code in one plugin, keeps the credentials in the plugin&#x27;s namespaced&#10;secret store, and keeps a ClubGear installation without Nextcloud fully functional." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="934" width="500" height="170" as="geometry"/></mxCell><mxCell id="t49" value="What it costs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#c98a1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="908" width="500" height="20" as="geometry"/></mxCell><mxCell id="t50" value="· CORE-02 grows by roughly S: a backend interface, a backend column on the metadata&#10;  row, a migration job and an integrity check.&#10;· CORE-07 grows by roughly M–L: the store port, the cache and the optimistic write&#10;  path replace both the local event tables and the separate CalDAV connector that the&#10;  original backlog listed as CALDAV-01.&#10;· The Nextcloud plugin itself is M–L: WebDAV, CalDAV, discovery, chunked upload,&#10;  conflict reporting and health checks." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="600" y="934" width="500" height="170" as="geometry"/></mxCell><mxCell id="t51" value="What it does not change" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="908" width="500" height="20" as="geometry"/></mxCell><mxCell id="t52" value="· The sequence. Both ports are designed with CORE-02 and CORE-07; the Nextcloud&#10;  adapter can ship later without another core change.&#10;· The boundary. No Nextcloud type, config key or path appears in the core.&#10;· Plugin storage. A plugin still calls the core file service; it never sees WebDAV.&#10;· The default. A fresh installation runs entirely local, with no external dependency." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1140" y="934" width="500" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg10" name="10 · Calendar data lives in Nextcloud"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="CORE-07 in Nextcloud mode — the VEVENT is the record" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1300" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Instruction: everything entered into a calendar is stored in Nextcloud. ClubGear therefore has no events table and no registrations table for those calendars — only a cache it can throw away and rebuild." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="40" as="geometry"/></mxCell><mxCell id="b3" value="Write path — creating an event or registering for one" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1620" height="300" as="geometry"/></mxCell><mxCell id="n4" value="ClubGear UI&#10;or self-service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="170" width="200" height="70" as="geometry"/></mxCell><mxCell id="n5" value="CalendarService&#10;permission + policy check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="210" height="70" as="geometry"/></mxCell><mxCell id="n6" value="ICalendarStore&#10;upsert(item, ifMatch)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e3;strokeColor=#EF7D00;fontColor=#7a4a00;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="170" width="190" height="70" as="geometry"/></mxCell><mxCell id="n7" value="Nextcloud plugin&#10;CalDAV client" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="170" width="210" height="70" as="geometry"/></mxCell><mxCell id="n8" value="GET event&#10;read current ETag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="190" height="50" as="geometry"/></mxCell><mxCell id="n9" value="Check capacity&#10;against ATTENDEE list" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1000" y="212" width="190" height="50" as="geometry"/></mxCell><mxCell id="n10" value="PUT  If-Match: ETag" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="180" width="190" height="56" as="geometry"/></mxCell><mxCell id="n11" value="Nextcloud&#10;CalDAV collection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f4f6f8;strokeColor=#8a949c;fontColor=#3f474d;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1450" y="170" width="180" height="70" as="geometry"/></mxCell><mxCell id="n12" value="412 → re-read,&#10;re-check, retry (bounded)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf3e0;strokeColor=#c98a1e;fontColor=#7a5310;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="1220" y="262" width="190" height="56" as="geometry"/></mxCell><mxCell id="n13" value="Update read cache&#10;+ emit notification event" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="760" y="300" width="210" height="60" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n10" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e21" value="412 conflict" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#c98a1e;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#c98a1e;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n12" target="n8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e23" value="201 / 204" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#187344;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n11" target="n13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t24" value="Why the loop: with Nextcloud as the record there is no database transaction to hold a capacity&#10;limit. The limit is enforced optimistically — read ETag, verify free places, conditional write.&#10;Correct, and serialised per event; the cost is latency and a retry under concurrent sign-ups." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="70" y="300" width="660" height="90" as="geometry"/></mxCell><mxCell id="b25" value="Read path — a calendar query" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="800" height="290" as="geometry"/></mxCell><mxCell id="n26" value="Query&#10;range · unit · status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf3f9;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="200" height="60" as="geometry"/></mxCell><mxCell id="n27" value="Read cache (index)&#10;derived, discardable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d7ecf7;strokeColor=#0077BA;fontColor=#16354f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="220" height="60" as="geometry"/></mxCell><mxCell id="n28" value="ctag / sync-token changed?&#10;sync-collection REPORT&#10;fetch only what moved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3ecfa;strokeColor=#5b3d86;fontColor=#3d2a5c;fontSize=11;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="240" height="80" as="geometry"/></mxCell><mxCell id="e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e30" value="on miss or stale" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;jettySize=auto;orthogonalLoop=1;strokeColor=#0077BA;fontColor=#4d5358;fontSize=11;endArrow=blockThin;endFill=1;labelBackgroundColor=#ffffff;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="t31" value="The cache exists because CalDAV cannot answer »all events of unit X in September where I am&#10;registered« without fetching and parsing the collection. It holds no authority: »Rebuild cache«&#10;drops and refetches it, and a disagreement is always resolved in favour of Nextcloud.&#10;&#10;If Nextcloud is unreachable the calendar is readable from cache, flagged stale, and writes fail." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="70" y="590" width="740" height="120" as="geometry"/></mxCell><mxCell id="b32" value="What this removes from the ClubGear schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="440" width="780" height="290" as="geometry"/></mxCell><mxCell id="n33" value="No events table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="490" width="340" height="50" as="geometry"/></mxCell><mxCell id="n34" value="No registrations table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="550" width="340" height="50" as="geometry"/></mxCell><mxCell id="n35" value="No waitlist table" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=11;align=center;verticalAlign=middle;arcSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="610" width="340" height="50" as="geometry"/></mxCell><mxCell id="t36" value="…for calendars in Nextcloud mode.&#10;&#10;Local mode keeps the tables and stays available for&#10;installations without Nextcloud. The two modes share&#10;the same service and the same UI; only the store&#10;implementation differs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1280" y="490" width="360" height="180" as="geometry"/></mxCell><mxCell id="b37" value="Consequences to accept with this decision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1620" height="320" as="geometry"/></mxCell><mxCell id="t38" value="Capacity is optimistic, not transactional" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#b05252;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="800" width="370" height="40" as="geometry"/></mxCell><mxCell id="t39" value="Enforced by ETag + If-Match with a bounded retry. Two members&#10;hitting the last free place still resolve correctly, but one gets a&#10;retry and, in the worst case, a »place just taken« message." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="70" y="840" width="370" height="160" as="geometry"/></mxCell><mxCell id="t40" value="Foreign clients can damage extensions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#b05252;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="800" width="370" height="40" as="geometry"/></mxCell><mxCell id="t41" value="Capacity, unit and waitlist ride on X- properties. A phone or desktop&#10;CalDAV client editing the event may drop unknown properties or&#10;attendee lines. Recommendation: share managed calendars read-only&#10;and keep writes in ClubGear or the Nextcloud web UI." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="470" y="840" width="370" height="160" as="geometry"/></mxCell><mxCell id="t42" value="Availability and backup move to Nextcloud" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#c98a1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="800" width="370" height="40" as="geometry"/></mxCell><mxCell id="t43" value="There is deliberately no local master copy. Nextcloud downtime means&#10;a read-only, stale calendar. Deleting the collection in Nextcloud&#10;deletes the data — restoring it is a Nextcloud restore." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="870" y="840" width="370" height="160" as="geometry"/></mxCell><mxCell id="t44" value="Personal data leaves the ClubGear database" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#c98a1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1270" y="800" width="370" height="40" as="geometry"/></mxCell><mxCell id="t45" value="Attendee names and addresses live in the Nextcloud instance. A member&#10;deletion request must purge ATTENDEE entries across all collections,&#10;which is why the member ↔ attendee link stays in ClubGear." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1270" y="840" width="370" height="160" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg11" name="11 · Do not execute"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t1" value="Do not execute — the decisions that are as binding as the plan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=20;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1300" height="30" as="geometry"/></mxCell><mxCell id="t2" value="Every item here was either written into the specifications as »out of scope«, or observed in Clubmanager as something that cost real money. A plan without these is only half a plan." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1420" height="40" as="geometry"/></mxCell><mxCell id="b3" value="Architecture rules — violating one of these invalidates the boundary, not just the task" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1620" height="470" as="geometry"/></mxCell><mxCell id="n4" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="780" height="96" as="geometry"/></mxCell><mxCell id="t5" value="DNX-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="160" width="70" height="18" as="geometry"/></mxCell><mxCell id="t6" value="No provider-specific code in the core" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="158" width="680" height="20" as="geometry"/></mxCell><mxCell id="t7" value="Matrix, Telegram, WhatsApp, SMS, E-Post, Nextcloud, Listmonk, Traccar and postal services are&#10;plugins behind generic contracts. No provider DTO, config key, icon or destination format in core." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="76" y="182" width="750" height="40" as="geometry"/></mxCell><mxCell id="t8" value="Evidence: Clubmanager keeps a MatrixAgent in the host and a 42 KB NextcloudCalendarService in Services/." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="76" y="222" width="750" height="20" as="geometry"/></mxCell><mxCell id="n9" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="150" width="780" height="96" as="geometry"/></mxCell><mxCell id="t10" value="DNX-02" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="160" width="70" height="18" as="geometry"/></mxCell><mxCell id="t11" value="No core branch on a module id" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="158" width="680" height="20" as="geometry"/></mxCell><mxCell id="t12" value="The host must never compare a plugin id to select behaviour, and the contract must never carry an&#10;Inventory-, Finance- or Newsletter-specific type." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="876" y="182" width="750" height="40" as="geometry"/></mxCell><mxCell id="t13" value="Evidence: This is the rule that keeps CORE-03 an investment instead of a growing switch statement." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="876" y="222" width="750" height="20" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="258" width="780" height="96" as="geometry"/></mxCell><mxCell id="t15" value="DNX-03" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="268" width="70" height="18" as="geometry"/></mxCell><mxCell id="t16" value="No cross-schema access in either direction" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="266" width="680" height="20" as="geometry"/></mxCell><mxCell id="t17" value="A plugin does not read core tables; the core does not read plugin tables. Everything goes through a&#10;read model or a contract facade." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="76" y="290" width="750" height="40" as="geometry"/></mxCell><mxCell id="t18" value="Evidence: Named explicitly in the Inventory 2.0 and Finance 2.0 specs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="76" y="330" width="750" height="20" as="geometry"/></mxCell><mxCell id="n19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="258" width="780" height="96" as="geometry"/></mxCell><mxCell id="t20" value="DNX-04" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="268" width="70" height="18" as="geometry"/></mxCell><mxCell id="t21" value="No silent fallback" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="266" width="680" height="20" as="geometry"/></mxCell><mxCell id="t22" value="If a notification channel or a storage backend is unavailable, the declared policy applies and the&#10;operation reports it. Never quietly send through another medium or write to the other store." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="876" y="290" width="750" height="40" as="geometry"/></mxCell><mxCell id="t23" value="Evidence: Applies to CORE-04 and, since the Nextcloud decision, to CORE-02 and CORE-07 as well." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="876" y="330" width="750" height="20" as="geometry"/></mxCell><mxCell id="n24" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="366" width="780" height="96" as="geometry"/></mxCell><mxCell id="t25" value="DNX-05" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="376" width="70" height="18" as="geometry"/></mxCell><mxCell id="t26" value="No second plugin architecture" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="374" width="680" height="20" as="geometry"/></mxCell><mxCell id="t27" value="No out-of-process or gRPC plugin host next to the existing in-process contract host, and no&#10;server-side Razor assembly loaded outside contract control." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="76" y="398" width="750" height="40" as="geometry"/></mxCell><mxCell id="t28" value="Evidence: Clubmanager&#x27;s out-of-process attempt is explicitly not being ported." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="76" y="438" width="750" height="20" as="geometry"/></mxCell><mxCell id="n29" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="366" width="780" height="96" as="geometry"/></mxCell><mxCell id="t30" value="DNX-06" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="376" width="70" height="18" as="geometry"/></mxCell><mxCell id="t31" value="No parallel template systems" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="374" width="680" height="20" as="geometry"/></mxCell><mxCell id="t32" value="Exactly one versioned template system. The existing simple renderer is replaced, not kept beside&#10;CORE-05." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="876" y="398" width="750" height="40" as="geometry"/></mxCell><mxCell id="t33" value="Evidence: Clubmanager runs a V1 template portal and V2 controllers side by side — the mistake to avoid." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="876" y="438" width="750" height="20" as="geometry"/></mxCell><mxCell id="n34" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="474" width="780" height="96" as="geometry"/></mxCell><mxCell id="t35" value="DNX-07" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="76" y="484" width="70" height="18" as="geometry"/></mxCell><mxCell id="t36" value="No paths and no secrets in ordinary configuration" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="140" y="482" width="680" height="20" as="geometry"/></mxCell><mxCell id="t37" value="Controllers never touch the filesystem directly, and credentials never live in a plain config value.&#10;Secrets are encrypted at rest, redacted in UI and logs." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="76" y="506" width="750" height="40" as="geometry"/></mxCell><mxCell id="t38" value="Evidence: Both Nextcloud config tables store the app password with a // TODO: Verschlüsseln comment." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="76" y="546" width="750" height="20" as="geometry"/></mxCell><mxCell id="n39" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbe9e9;strokeColor=#b05252;fontColor=#8a2f2f;fontSize=13;align=center;verticalAlign=middle;arcSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="474" width="780" height="96" as="geometry"/></mxCell><mxCell id="t40" value="DNX-08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="876" y="484" width="70" height="18" as="geometry"/></mxCell><mxCell id="t41" value="No hard-coded state machine beside the workflow engine" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=13.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="940" y="482" width="680" height="20" as="geometry"/></mxCell><mxCell id="t42" value="If CORE-06 is built, rental and approvals register definitions in it. If CORE-06 is not built,&#10;that is a conscious cut — not a licence to hard-code states." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="876" y="506" width="750" height="40" as="geometry"/></mxCell><mxCell id="t43" value="Evidence: Clubmanager built 5 workflow tables and then bypassed them with a 14 KB RentalStateMachine." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.5;fontColor=#7a5310;" vertex="1" parent="1"><mxGeometry x="876" y="546" width="750" height="20" as="geometry"/></mxCell><mxCell id="b44" value="Do not port these, even though they exist and work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="800" height="300" as="geometry"/></mxCell><mxCell id="t45" value="✕  Thousand-line controllers as a porting unit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="780" height="18" as="geometry"/></mxCell><mxCell id="t46" value="MembersController is 277 KB, InventoryController 128 KB, FinanceController 73 KB. Each domain gets&#10;services, commands/queries, thin endpoints and its own tests." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="658" width="740" height="34" as="geometry"/></mxCell><mxCell id="t47" value="✕  ReferateController as a set of hard-coded view names" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="692" width="780" height="18" as="geometry"/></mxCell><mxCell id="t48" value="Departments become configurable organisation units (CORE-01) plus plugin navigation." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="710" width="740" height="34" as="geometry"/></mxCell><mxCell id="t49" value="✕  Keycloak group management as the local authority" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="744" width="780" height="18" as="geometry"/></mxCell><mxCell id="t50" value="Local roles stay authoritative; external group mapping is IamOidc plugin work." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="762" width="740" height="34" as="geometry"/></mxCell><mxCell id="t51" value="✕  Debug controllers as productive routes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="796" width="780" height="18" as="geometry"/></mxCell><mxCell id="t52" value="Token and claims pages are development-only diagnostics, not a product feature." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="814" width="740" height="34" as="geometry"/></mxCell><mxCell id="t53" value="✕  ToolRental as a second plugin" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#8a2f2f;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="848" width="780" height="18" as="geometry"/></mxCell><mxCell id="t54" value="Simple lending belongs in Inventory 2.0; commercial rental in RENT-01. Never both." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="80" y="866" width="740" height="34" as="geometry"/></mxCell><mxCell id="b55" value="Out of scope per feature — taken verbatim from the specifications" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="880" y="600" width="780" height="300" as="geometry"/></mxCell><mxCell id="t56" value="CORE-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="638" width="90" height="16" as="geometry"/></mxCell><mxCell id="t57" value="hard-coded department pages · Keycloak groups as authority · business data" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="638" width="660" height="16" as="geometry"/></mxCell><mxCell id="t58" value="CORE-02" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="661" width="90" height="16" as="geometry"/></mxCell><mxCell id="t59" value="domain image galleries · a mandatory cloud vendor or scanner · public CMS routing" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="661" width="660" height="16" as="geometry"/></mxCell><mxCell id="t60" value="CORE-03" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="684" width="90" height="16" as="geometry"/></mxCell><mxCell id="t61" value="a second plugin architecture · plugin-specific behaviour in core · free Razor assemblies" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="684" width="660" height="16" as="geometry"/></mxCell><mxCell id="t62" value="CORE-04" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="707" width="90" height="16" as="geometry"/></mxCell><mxCell id="t63" value="person-to-person chat · shipping any third-party provider in core · campaign management" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="707" width="660" height="16" as="geometry"/></mxCell><mxCell id="t64" value="CORE-05" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="730" width="90" height="16" as="geometry"/></mxCell><mxCell id="t65" value="campaign selection and scheduling · a scripting language in templates · SMTP/Listmonk config" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="730" width="660" height="16" as="geometry"/></mxCell><mxCell id="t66" value="CORE-06" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="753" width="90" height="16" as="geometry"/></mxCell><mxCell id="t67" value="a visual BPMN engine · hard-coded rental seed workflows · domain forms and calculations" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="753" width="660" height="16" as="geometry"/></mxCell><mxCell id="t68" value="CORE-07" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="776" width="90" height="16" as="geometry"/></mxCell><mxCell id="t69" value="Nextcloud entities or credentials in core · meeting minutes · room booking in release 1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="776" width="660" height="16" as="geometry"/></mxCell><mxCell id="t70" value="CORE-08" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="799" width="90" height="16" as="geometry"/></mxCell><mxCell id="t71" value="shared login credentials · automatic guardianship · fee or discount calculation in core" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="799" width="660" height="16" as="geometry"/></mxCell><mxCell id="t72" value="INV-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="822" width="90" height="16" as="geometry"/></mxCell><mxCell id="t73" value="deposits, payouts, damage settlement · direct member/finance/org table access · a second ToolRental" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="822" width="660" height="16" as="geometry"/></mxCell><mxCell id="t74" value="FIN-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="845" width="90" height="16" as="geometry"/></mxCell><mxCell id="t75" value="general accounting, tax, payroll · rental deposits before a contract exists · bank data in core" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="845" width="660" height="16" as="geometry"/></mxCell><mxCell id="t76" value="NEWS-01" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="868" width="90" height="16" as="geometry"/></mxCell><mxCell id="t77" value="postal delivery · editing core member records · a hard dependency on Listmonk" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10.8;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="985" y="868" width="660" height="16" as="geometry"/></mxCell><mxCell id="b78" value="How this list is meant to be used" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f9fb;strokeColor=#dde3e8;fontColor=#5f6368;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;arcSize=4;dashed=0;" vertex="1" parent="1"><mxGeometry x="40" y="920" width="1620" height="230" as="geometry"/></mxCell><mxCell id="t79" value="It is a review checklist, not a manifesto" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#187344;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="958" width="500" height="20" as="geometry"/></mxCell><mxCell id="t80" value="Each DNX item is phrased so it can be checked against a diff.&#10;»Does this change add a provider name to the core?« has a yes/no&#10;answer; »keep the architecture clean« does not.&#10;&#10;Four of them can be enforced by an automated test rather than by&#10;review: DNX-01, DNX-02, DNX-03 and DNX-06." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="60" y="984" width="500" height="150" as="geometry"/></mxCell><mxCell id="t81" value="Breaking one is allowed — silently is not" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#c98a1e;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="958" width="500" height="20" as="geometry"/></mxCell><mxCell id="t82" value="There will be a day when shipping a provider inside the core is the&#10;pragmatic choice. The rule is not »never«, it is: write down which&#10;item you are breaking, why, and what would undo it.&#10;&#10;That is the difference between a deliberate exception and the&#10;state Clubmanager arrived at over several years." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="600" y="984" width="500" height="150" as="geometry"/></mxCell><mxCell id="t83" value="What is deliberately NOT on this list" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12.5;fontColor=#0077BA;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1140" y="958" width="500" height="20" as="geometry"/></mxCell><mxCell id="t84" value="Features the club may simply not want — birthday greetings, GPS&#10;tracking, chat, CMS. Those are priority decisions and belong in the&#10;pitch deck, not here.&#10;&#10;This page is only about things that would damage the architecture&#10;or repeat a known, paid-for mistake." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontColor=#5f6368;" vertex="1" parent="1"><mxGeometry x="1140" y="984" width="500" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="pg12" name="M01 · CORE-01"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1360" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCe